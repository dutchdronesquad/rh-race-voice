# Copy this file to .env before running docker compose.
#
# Container networking defaults. Keep the ingest host at 0.0.0.0 when exposing
# the API through Docker port publishing.
SENDSPIN_INGEST_HOST=0.0.0.0
SENDSPIN_INGEST_PORT=8766
SENDSPIN_HOST=0.0.0.0
SENDSPIN_PORT=8927
SENDSPIN_ADVERTISE=false
SENDSPIN_MAX_BODY_MB=50
SENDSPIN_PLAYER_DIR=/opt/sendspin-service/player

# Required for any Docker deployment, local or internet-facing: the service
# binds 0.0.0.0 internally so Docker port publishing can reach it, and
# refuses to start without a token once bound to a non-loopback address.
# Producers must send it as: Authorization: Bearer <token>
SENDSPIN_API_TOKEN=change-this-token

# Optional: relay audio+context to a remote instance of this same service
# (e.g. one deployed with this Dockerfile on a cloud host), in addition to
# local playback. Leave SENDSPIN_RELAY_URL empty to disable the relay. The
# relay token is a separate credential from SENDSPIN_API_TOKEN above and is
# required whenever the relay URL is not on loopback.
SENDSPIN_RELAY_URL=
SENDSPIN_RELAY_TOKEN=change-this-relay-token
SENDSPIN_RELAY_TIMEOUT_S=5.0

# Set to false for a relay-only primary (no local Sendspin output).
SENDSPIN_LOCAL_OUTPUT_ENABLED=true

# Optional: accept relayed audio+context from another instance's relay (the
# "cloud" side of a local+cloud deployment). Off by default. Authenticated
# with the same SENDSPIN_RELAY_TOKEN as the relaying primary above, and
# required whenever this is enabled off loopback.
SENDSPIN_RELAY_RECEIVER_ENABLED=false
