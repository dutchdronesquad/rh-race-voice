{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>dutchdronesquad/.github:renovate-python"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^custom_plugins/race_voice/manifest\\.json$/"],
      "matchStrings": [
        "\"(?<depName>[A-Za-z0-9_.-]+)(?:==|!=|<=|>=|~=|<|>)\\s*(?<currentValue>[^\"\\s,]+)\""
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "Update the RotorHazard stable compatibility pin",
      "managerFilePatterns": ["/^tests/rotorhazard\\.json$/"],
      "matchStrings": [
        "\"stable\"\\s*:\\s*\"(?<currentValue>[^\"@]+)@(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "RotorHazard stable",
      "packageNameTemplate": "RotorHazard/RotorHazard",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the RotorHazard development compatibility pin",
      "managerFilePatterns": ["/^tests/rotorhazard\\.json$/"],
      "matchStrings": [
        "\"development\"\\s*:\\s*\"(?<currentValue>[^\"@]+)@(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "RotorHazard development",
      "packageNameTemplate": "RotorHazard/RotorHazard",
      "datasourceTemplate": "github-digest",
      "versioningTemplate": "exact"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["tool.uv.dependency-groups"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["npm"]
    },
    {
      "matchManagers": ["github-actions"],
      "extractVersion": "^(?<version>v\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Review RotorHazard compatibility pin updates through the normal PR tests",
      "matchFileNames": ["tests/rotorhazard.json"],
      "pinDigests": true,
      "ignoreUnstable": true,
      "automerge": false,
      "groupName": "RotorHazard compatibility pins",
      "addLabels": ["enhancement"]
    }
  ]
}
